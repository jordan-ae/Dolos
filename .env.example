# --- Postgres ---
POSTGRES_USER=dolos
POSTGRES_PASSWORD=dolos
POSTGRES_DB=dolos

# --- Redis (broker + pub/sub for job progress) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3-compatible storage ---
# For local dev, MinIO is run via docker-compose. To use AWS S3 in production,
# set S3_ENDPOINT_URL to "" (empty) and provide real AWS credentials + region.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=dolos-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# Public base URL used to build preview/export links returned to the frontend.
# Point this at your CDN/reverse proxy in production.
S3_PUBLIC_URL=http://localhost:9000/dolos-media

# --- Auth (placeholder - wire up Clerk or Auth.js in apps/web) ---
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- OpenMontage generation engine (local-only, no paid API credits) ---
# https://github.com/calesthio/OpenMontage
# OpenMontage is agent-first (no headless CLI); our worker calls its
# tools/audio/piper_tts.py and tools/avatar/talking_head.py (SadTalker)
# tool classes directly. Clone the repo, run `make setup` + `make install-gpu`
# and SadTalker's own setup, then point this at the clone:
OPENMONTAGE_REPO_PATH=/opt/OpenMontage
VIDEO_GEN_LOCAL_ENABLED=true
VIDEO_GEN_LOCAL_MODEL=wan2.1-14b
# Required by tools/avatar/talking_head.py - see its install_instructions
SADTALKER_PATH=/opt/SadTalker

# If you are not running a local GPU box, point the worker at a remote
# GPU host (self-hosted or RunPod serverless endpoint) instead. When set,
# the worker calls this HTTP endpoint rather than invoking the pipeline
# in-process. Leave blank to run the pipeline locally.
OPENMONTAGE_REMOTE_ENDPOINT=
OPENMONTAGE_REMOTE_API_KEY=

# --- Studio pipeline (default real pipeline) ---
# Natural voice (XTTS-v2) + livelier talking head (Hallo2) + matted subject
# composited over a lively studio background. See README "Studio pipeline".
# REAL_PIPELINE=studio         # "studio" (default) or "openmontage" (legacy)
#
# Voice: XTTS-v2 (natural, clonable) vs piper (fast, robotic)
TTS_ENGINE=xtts
XTTS_SPEAKER=Ana Florence      # a built-in XTTS studio speaker...
XTTS_SPEAKER_WAV=              # ...or a ~6s reference wav to clone a voice
XTTS_LANGUAGE=en
#
# Talking head: hallo2 (livelier, audio-driven) vs sadtalker (legacy)
TALKING_HEAD_MODEL=hallo2
HALLO_REPO_PATH=/opt/hallo2    # clone of fudan-generative-vision/hallo2 + models
#
# Lively background: matte the subject with RVM and composite over a looping
# studio clip (soft bokeh / LED panels / plants). Empty STUDIO_BG_PATH keeps
# the talking head on its native frozen background.
ENABLE_STUDIO_COMPOSITE=true
STUDIO_BG_PATH=/opt/assets/studio_loop.mp4
BG_MOTION=true                 # subtle slow zoom on the background for "life"
RVM_REPO_PATH=/opt/RobustVideoMatting   # clone of PeterL1n/RobustVideoMatting
RVM_VARIANT=mobilenetv3        # or resnet50
RVM_WEIGHTS=/opt/RobustVideoMatting/rvm_mobilenetv3.pth

# --- Stubbing ---
# When true, the worker fakes each pipeline stage with a sleep instead of
# running a real pipeline. Used to validate the end-to-end flow before wiring
# up the real GPU pipeline.
WORKER_STUB_MODE=true

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
